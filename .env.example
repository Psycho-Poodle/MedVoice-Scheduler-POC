# Environment template for local/dev setup

# --- General ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1
BACKEND_RELOAD=true
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
VITE_MCP_BASE_URL=http://localhost:8100
VITE_VAPI_PUBLIC_KEY=
VITE_VAPI_ASSISTANT_ID=

# --- MCP Server ---
MCP_HOST=0.0.0.0
MCP_PORT=8100
MCP_TRANSPORT=http

# --- PostgreSQL ---
POSTGRES_DB=medvoice
POSTGRES_USER=medvoice_user
POSTGRES_PASSWORD=medvoice_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://medvoice_user:medvoice_password@postgres:5432/medvoice

# --- Vector / AI placeholders ---
PGVECTOR_DIMENSIONS=1536
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash-lite
GEMINI_LIVE_VOICE=Kore
